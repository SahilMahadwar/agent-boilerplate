{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // Emits declarations only, so the client can import `type AppRouterClient`
    // through a project reference without type-checking worker code itself.
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/worker",
    "tsBuildInfoFile": "node_modules/.cache/tsc/worker/tsconfig.worker.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    // Runtime + binding types come from the generated worker-configuration.d.ts
    // (see the `cf-typegen` script); do not also pull in @cloudflare/workers-types.
    "types": []
  },
  "include": ["src", "worker-configuration.d.ts"]
}
