{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./client/src/*"]
    }
  },
  "include": ["client"],
  // Gives the client the worker's declarations (the oRPC router type) without
  // compiling worker code under browser types.
  "references": [{ "path": "./tsconfig.worker.json" }]
}
