{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mastra-hono",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-09",
  // global_fetch_strictly_public is required by the OAuth provider for CIMD clients (ChatGPT).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The Worker runs first for every request (auth, MCP OAuth discovery) and serves
  // the SPA through the ASSETS binding.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mastra-hono-local",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
  // OAuth clients, grants and tokens for the MCP endpoint (see docs/mcp.md).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local" }],
  // Fires due schedules every minute (src/schedules/runner.ts).
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
  },

  "env": {
    "production": {
      // Better Auth's public origin (Google redirect URIs are built from it).
      "vars": { "BETTER_AUTH_URL": "https://mastra-hono-production.rick.workers.dev" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mastra-hono-prd",
          "database_id": "d7061e26-e533-414b-a8e2-3fc2c6576273",
          "migrations_dir": "migrations",
        },
      ],
      // Create with: npx wrangler kv namespace create OAUTH_KV --env production
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "2bbd20ae90284a9789bcf0fe77cf280e" }],
    },
  },
}
